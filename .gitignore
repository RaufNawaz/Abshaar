# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# JavaScript / website
node_modules/
dist/
.astro/
.vite/

# Local secrets
.env
.env.*
!.env.example

# Large local model artifacts
models/
*.bin
*.safetensors
*.gguf
*.onnx

# The 'max' training build: the dataset run 2 was actually trained on.
# Kept out of git because it includes Rafat's copyrighted reference
# translations (63 train / 8 eval) and probes.jsonl carries his published
# English verbatim in its `reference` field. MANIFEST.md and SHA256SUMS.txt
# are committed so the provenance chain in training/EVAL_MATRIX.md is
# checkable without redistributing the text.
data/processed/training_max/*
!data/processed/training_max/MANIFEST.md
!data/processed/training_max/SHA256SUMS.txt

# Result archives copied back from a training machine. Verified on import
# against their own SHA256SUMS.txt, then kept locally as a sealed copy.
*_results.zip

# Generated caches and private source material
data/cache/
data/site/
data/raw/private/
data/processed/private/*
!data/processed/private/sufinama_bulleh_shah_kaafi.jsonl
!data/processed/private/sufinama_run.json
!data/processed/private/sufinama_bulleh_shah_other_texts.jsonl
!data/processed/private/sufinama_texts_run.json

# Local source-book scans (bibliographic records may be committed; scans may not)
Bulleh Shah/*.pdf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json

# LaTeX build artifacts (scoped to docs/ for *.log, which otherwise hid
# training/logs/*.log -- the runs' own validation curves, cited by
# training/EVAL_MATRIX.md)
*.aux
docs/*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz

# Python packaging
*.egg-info/

# Model weights (large; record SHA-256 + eval scores in training/EVAL_MATRIX.md)
training/adapters/
training/fused/
training/portable_bundle/
training/dist/
training/pipeline_logs/
training/RUN_AUTHORIZED

# RAG pipeline run state and outputs (regenerate with scripts/rag_pipeline.sh).
# The Chroma index is derived data and embeds the private knowledge base.
training/.pipeline_state/
training/rag_outputs/
